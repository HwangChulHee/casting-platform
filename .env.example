# ─── Supabase ───────────────────────────────────────────
# 브라우저에 노출되는 값 (Next.js: NEXT_PUBLIC_ 접두사 필수)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — 절대 프론트로 내보내지 않는다
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ─── Database (Drizzle → PostgreSQL) ────────────────────
# Supabase 대시보드 → Connect → Session pooler 주소를 쓴다.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# 주의 1) direct 주소(db.<ref>.supabase.co)는 IPv6 전용이라 WSL2/대부분의 CI에서 연결되지 않는다.
# 주의 2) 비밀번호의 @ # ? / : 등은 퍼센트 인코딩 필수 (@ → %40, # → %23).
# 주의 3) 마이그레이션은 session pooler(5432)로. transaction pooler(6543)는 prepared statement 미지원.
DATABASE_URL=

# ─── Redis (캐시 + BullMQ 큐) ───────────────────────────
REDIS_URL=redis://localhost:6379

# ─── OpenAI ─────────────────────────────────────────────
OPENAI_API_KEY=

# ─── App ────────────────────────────────────────────────
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# API가 CORS로 허용할 프론트 오리진 (배포 시 Vercel 도메인)
WEB_ORIGIN=http://localhost:3000
