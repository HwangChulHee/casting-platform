{
  "name": "@casting/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    "./router": {
      "types": "./dist/trpc/router.d.ts",
      "default": "./dist/trpc/router.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@casting/db": "workspace:*",
    "@casting/shared": "workspace:*",
    "@trpc/server": "^11.18.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@casting/config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
